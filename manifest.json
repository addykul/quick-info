{
  "manifest_version": 3,
  "name": "QuickInfo — Job Details",
  "version": "1.0.0",
  "description": "Keep your job application details handy and copy them in one click.",
  "permissions": ["storage", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "QuickInfo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
